# About me
set realname = "Andrey Albershteyn"
set from = "aalbersh@redhat.com"
alternates "(andrey.albershteyn@redhat\.com)"

# Credentials
set smtp_url = "smtps://aalbersh@redhat.com@smtp.gmail.com/"
set imap_user = "aalbersh@redhat.com"

# People
alias me Andrey Albershteyn <aalbersh@redhat.com>
alias eric Eric Sandeen <esandeen@redhat.com>
alias cem Carlos Maiolino <cmaiolino@redhat.com>
alias bill Bill O'Donnel <bodonnel@redhat.com>
alias dave Dave Chinner <dchinner@redhat.com>
alias djwong Darrick J. Wong <djwong@kernel.org>

# Highlight the boss =)
color index blue default "~f esandeen@redhat.com"
color index blue default "~f sandeen@redhat.com"
# Highlight mailing list announces
color index cyan default "~s ANNOUNCE"
# Highlight reminders from Workday
color index blue default "~f timetracking@redhat.com"

# Mailboxes
virtual-mailboxes "fstests" "notmuch://?query=tag:fstests"
virtual-mailboxes "xfs" "notmuch://?query=tag:linux-xfs"
virtual-mailboxes "fsdevel" "notmuch://?query=tag:linux-fsdevel"
virtual-mailboxes "kernel-info" "notmuch://?query=tag:kernel-info"
virtual-mailboxes "bugzilla" "notmuch://?query=tag:bugzilla-hook-filter or (tag:bugzilla)"
virtual-mailboxes "gitlab" "notmuch://?query=tag:gitlab"
virtual-mailboxes "memos" "notmuch://?query=tag:memos"
virtual-mailboxes "brew" "notmuch://?query=tag:brew"
virtual-mailboxes "beaker" "notmuch://?query=tag:beaker"

# Remove crap in Jira emails
# Reset display filter for all
folder-hook . "set display_filter=''"
# Set filter for Jira/Bugzilla folder
folder-hook "bugzilla-hook-filter" "set display_filter='~/.redhat/neomutt-jira.sh'"
