#!/usr/bin/env sh

# Shell configuration
#
# @author: Andrey Albershteyn
# @date: 2018

# Linux Dev
KERNEL=$HOME/Projects/kernel/linux
alias kernel="cd $KERNEL"
fm() {
	git --no-pager -C $KERNEL log --no-merges -n 1 --oneline --grep "$1" | \
		cut -d' ' -f1
}

mm() {
	parse-lore.py $@
}

alias bkr-reset="bkr system-power --action=reboot"

# Add indication when battery is too low. I often connect to laptop via ssh
battery() {
	charge=$(cat /sys/class/power_supply/BAT0/capacity)
	if [ $((charge)) -lt 10 ]; then
		bold=$(tput bold)
		normal=$(tput sgr0)
		RED='\033[0;31m'
		NC='\033[0m'
		echo -e -n "${RED}${bold}B!${normal}${NC} "
	fi

	echo -e -n ""
}
PROMPT+='$(battery)'

export CCACHE_DIR=/var/cache/ccache/
export CCACHE_SLOPPINESS=random_seed
export KBUILD_BUILD_TIMESTAMP=""
