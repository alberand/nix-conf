# Configuration of remote store
IMAPAccount gmail
Host imap.gmail.com
Port 993
User aalbersh@redhat.com
PassCmd "gpg --no-tty -qd $HOME/.secrets/email-passwords.sh.gpg | awk -F\\\" '/MUTT_PASS/ {print $2}'"
TLSType IMAPS
TLSVersions +1.2 +1.3
CertificateFile ~/.secrets/imap.gmail.com.pem
CertificateFile ~/.secrets/Equifax_Secure_CA.pem

IMAPStore gmail-remote
Account gmail

# Configuration of local store
MaildirStore redhat-local
SubFolders Verbatim
# The trailing "/" is important
Path ~/.mail/gmail/
Inbox ~/.mail/gmail/inbox/

# Synchronization channel between remote and local
# Just a name
Channel redhat-inbox
# What we're connecting on a remote side
Far :gmail-remote:"[Gmail]/All Mail"
# What we're connecting on a local side
Near :redhat-local:inbox
Sync All
# Don't create mailboxes, as I don't use them, both locally and on the server
Create None
# Remove messages on remote, removed locally
Remove Both
Expunge Both
# Save the synchronization state files in the in channel (~/.mail/gmail)
# directory
SyncState *
# Better arrival date?
CopyArrivalDate yes

# Just a name
Channel redhat-sent
# What we're connecting on a remote side
Far :gmail-remote:"[Gmail]/Sent Mail"
# What we're connecting on a local side
Near :redhat-local:sent
Sync All
# Dont create mailboxes, as I don't use them, both locally and on the server
Create None
# Sync the movement of messages between folders and deletions, add after making
# sure the sync works
Expunge Both
# Save the synchronization state files in the in channel (~/.mail/gmail)
# directory
SyncState *
# Better arrival date?
CopyArrivalDate yes

Group redhat
Channels redhat-inbox redhat-sent
