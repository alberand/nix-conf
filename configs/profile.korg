# kernel.org account
set from         = "aalbersh@kernel.org"
set realname     = "Andrey Albershteyn"

set smtp_url     = "smtps://aalbersh@mail.kernel.org:465/"
set smtp_pass    = "$KORG_PASS"
set ssl_starttls = yes

set signature    = "~/.config/neomutt/signature.korg"
set folder       = "~/.mail/korg/inbox"

unmailboxes *
virtual-mailboxes "inbox" "notmuch://?query=tag:korg"
virtual-mailboxes "xfsprogs" "notmuch://?query=tag:xfsprogs-list"

color status     brightgreen    blue	# korg
